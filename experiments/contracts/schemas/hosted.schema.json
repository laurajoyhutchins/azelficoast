{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azelficoast.invalid/schemas/hosted-research-contracts.schema.json",
  "title": "Azelficoast hosted research orchestration contract",
  "description": "Shape of the repo-owned hosted studies and their artifact transport; not research admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "studies"
  ],
  "properties": {
    "schema": {
      "const": "azelficoast.hosted-research-contracts"
    },
    "studies": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/$defs/study"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "paths",
        "if_no_files"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "if_no_files": {
          "enum": [
            "warn",
            "error"
          ]
        }
      }
    },
    "prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "artifact"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operation",
        "units",
        "artifact"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "download_pattern",
        "artifact"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "download_pattern": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "prepare": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "evidence": {
          "type": "boolean"
        },
        "showdown": {
          "type": "boolean"
        }
      }
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths",
        "showdown",
        "evidence",
        "run"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "showdown": {
          "type": "boolean"
        },
        "evidence": {
          "type": "boolean"
        },
        "run": {
          "$ref": "#/$defs/run"
        },
        "prepare": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/prepare"
            }
          ]
        },
        "aggregate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/aggregate"
            }
          ]
        }
      }
    }
  }
}

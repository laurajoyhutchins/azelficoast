{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    "scripts/**/*.cjs",
    "scripts/node-globals.d.ts"
  ]
}
